# ===== Backend environment variables (Render -> Environment) =====
PORT=5000

# MongoDB Atlas connection string (any ONE of these names works)
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/smart-computers?retryWrites=true&w=majority

# Long random string used to sign admin login tokens
JWT_SECRET=change-me-to-a-long-random-string

# First admin login. Created automatically on the first successful login, then you can
# change the password from Admin -> Settings.
ADMIN_EMAIL=admin@smart.com
ADMIN_PASSWORD=Smart@12345
# Your Vercel site URL(s), comma separated - used for CORS and for certificate QR links
FRONTEND_URL=https://your-site.vercel.app
# (optional) full verify page URL for QR codes, default = FRONTEND_URL/verify-certificate
PUBLIC_VERIFY_BASE_URL=

# Cloudinary (banner / reel / notice / certificate / logo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
